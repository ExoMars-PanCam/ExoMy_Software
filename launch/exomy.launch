<launch>
    <node name="robot" pkg="exomy" type="robot_node.py" respawn="false" output="screen"/>
    <node name="motors" pkg="exomy" type="motor_node.py" respawn="false" output="screen" />
    <node name="joystick" pkg="exomy" type="joystick_parser_node.py" respawn="false" output="screen" />

    <node respawn="false" pkg="joy" type="joy_node" name="joy_node">
        <param name="coalesce_interval" value="0.05"/>
        <param name="autorepeat_rate" value="10.0"/>
    </node>

    <node pkg="web_video_server" type="web_video_server"  name="web_video_server" respawn="false" output="screen">
        <param name="default_transport" value="compressed"/>
        <param name="quality" value="50"/>
    </node>

    <node pkg="exomy" type="pi_camera_bridge.py" name="pi_camera_bridge"
          respawn="true" respawn_delay="5" output="screen">
        <param name="host" value="172.17.0.1"/>
        <param name="port" value="8888"/>
        <param name="topic" value="/pi_cam/image_raw"/>
        <param name="frame_id" value="pi_cam"/>
    </node>

    <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"/>
    <rosparam file="$(find exomy)/config/exomy.yaml"/> 

</launch>
